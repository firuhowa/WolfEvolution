
{
	"schemaVersion": 1,
	"id": "wolfevolution",
	"version": "${version}",
	"name": "WolfEvolution",
	"description": "A wolf overhaul mod featuring realistic behavior, advanced AI, combat, animations, and pack systems.",
	"authors": [
		"firuhowa"
	],
	"license": "CC0-1.0",
	"icon": "assets/wolfevolution/icon.png",
